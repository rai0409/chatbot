{
  "name": "sweep-model-chunk-dim-quant-fusion-rerank",
  "eval_set": "eval/bench_data/eval_set.jsonl",
  "split": "dev",
  "match_mode": "evidence",
  "corpus": {
    "chunks_jsonl": "index/chunks.canonical.bytype.dedup.jsonl",
    "documents_jsonl": null
  },
  "ks": [1, 3, 5, 10, 20, 50, 100],
  "ci_metrics": ["recall@10", "ndcg@10", "mrr@10", "hit@10", "recall@100"],
  "candidates": {"dense_top": 100, "lexical_top": 100, "fused_top": 100},
  "chunking": [
    {"mode": "as_is"},
    {"mode": "window", "chars": 400, "overlap": 0.1}
  ],
  "embedding": [
    {"model": "cl-nagoya/ruri-v3-130m", "prefix": "auto"},
    {"model": "cl-nagoya/ruri-v3-30m", "prefix": "auto"}
  ],
  "dimension": ["none", "pca:256"],
  "quantization": [
    {"type": "float32"},
    {"type": "int8", "rescore_oversample": 3}
  ],
  "dense_backend": [{"type": "exact"}],
  "lexical": [
    {"tokenizer": "heuristic", "k1": 1.5, "b": 0.75},
    {"tokenizer": "sudachi", "split_mode": "A", "k1": 1.2, "b": 0.75, "numeric_tokens": true}
  ],
  "fusion": [
    {"method": "dense_only"},
    {"method": "lexical_only"},
    {"method": "weighted_rrf", "k": 60},
    {"method": "weighted_rrf", "k": 10},
    {"method": "dbsf"}
  ],
  "rerank": [
    {"model": "cl-nagoya/ruri-v3-reranker-310m", "max_length": 512, "depths": [20, 30, 50, 100]}
  ],
  "bootstrap": {"resamples": 2000, "seed": 0},
  "query_latency_sample": 50,
  "max_evaluations": 1000
}
