# Copy to .env and fill in real values. Never commit .env.
# All values below are placeholders or the code defaults from config.py.

# --- OpenAI / LLM provider ---
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini

# --- Chat completion hardening ---
CHAT_COMPLETION_TIMEOUT_SECONDS=30
CHAT_COMPLETION_MAX_RETRIES=1
CHAT_COMPLETION_RETRY_BACKOFF_SECONDS=1.0
CHAT_COMPLETION_MAX_TOKENS=1024

# --- Free/local-only chat mode ---
# extractive mode does not call OpenAI chat completion.
# Use with EMBED_PROVIDER=local for free/local-oriented testing.
CHAT_GENERATION_MODE=extractive
# CHAT_GENERATION_MODE=llm

# --- Embeddings ---
# Providers: local | openai | bge_m3
# Must match the provider/model the vectorstore was ingested with
# (the collection is fingerprint-stamped at ingest and verified at query time).
# Changing the model or the prefixes requires re-ingesting the collection.
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=cl-nagoya/ruri-v3-130m
OPENAI_EMBED_MODEL=text-embedding-3-small
# true: refuse collections without a complete embedding stamp (provider, model, prefix scheme, normalization, distance, dimension).
EMBED_FINGERPRINT_STRICT=false
# File that says which index generation is served (written by scripts/switch_generation.py).
# Default: index/active_generation.json. CHROMA_COLLECTION, when set, overrides it.
# ACTIVE_GENERATION_FILE=
# Where versions of RAG profiles and their active pointers are kept (scripts/profile_versions.py).
# Default: data/profile_versions. Without an active version the profile is read from config/rag_profiles.
# PROFILE_STORE_DIR=
# Registered document sources, their manifests and the change ledger (scripts/sources.py). Default: data/sources.
# SOURCES_DIR=
# Per-line OCR output of scanned pages (text, confidence, position) for the extraction review (rag_core/extraction_store.py).
# Default: data/extraction. EXTRACTION_STORE_ENABLED=false turns saving off. Lines below the confidence need review.
# EXTRACTION_STORE_DIR=
# EXTRACTION_STORE_ENABLED=true
# EXTRACTION_REVIEW_MAX_CONFIDENCE=80
# Contract ledger (rag_core/contracts.py): one JSON file per contract. Default: data/contracts.
# CONTRACTS_DIR=
# Contract deadline reminders (rag_core/contract_notify.py): days before a deadline, most distant first.
# CONTRACT_REMINDER_DAYS=90,60,30,14,7,1,0
# Outlook drafts (rag_core/connectors/outlook.py; drafts only, nothing is sent): a token, or the client credentials.
# Limit the application to the one mailbox with an application access policy. Keep these out of committed files.
# OUTLOOK_ACCESS_TOKEN=
# OUTLOOK_TENANT_ID=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# Mass-change guard of source sync: hold a plan with >= MIN_DELETES deletions above this share of the applied files,
# or with more than MAX_CHANGES changes, until a person approves it (scripts/sources.py approve).
# SOURCE_MAX_DELETE_FRACTION=0.2
# SOURCE_MIN_DELETES_FOR_GUARD=5
# SOURCE_MAX_CHANGES=500
# SharePoint sources (rag_core/connectors/sharepoint.py): a ready access token, or the client credentials to request one.
# Grant the application read access to the one library only. Keep these out of files that are committed.
# SHAREPOINT_ACCESS_TOKEN=
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# true: run the retrieval_boost_rules of the RAG profile at query time (rag_core/profile_engine.py). Evaluate first.
PROFILE_BOOST_ENABLED=false
# Largest score (distance) change the profile rules can make to one chunk.
PROFILE_BOOST_MAX_DELTA=0.05
# true: also search rule-based variants of the question and fuse them by RRF (rag_core/multi_query.py). Evaluate first.
MULTI_QUERY_ENABLED=false
# Queries searched in all, the question included (a "deep" request uses at least 3).
MULTI_QUERY_MAX_VARIANTS=3
MULTI_QUERY_RRF_K=60
# Distance added to a chunk that only a variant found.
MULTI_QUERY_VARIANT_PENALTY=0.05
# true: weight the lanes of the hybrid fusion by query type (rag_core/query_route.py). Evaluate first.
QUERY_ROUTING_ENABLED=false
# Where an LLM may be used (docs/operations/llm_policy.md). Unset LLM_ENABLED: CHAT_GENERATION_MODE=llm turns it on;
# LLM_ENABLED=false is a kill switch. Empty allowlist = every tenant. Features: generate | rewrite | verify | judge.
# LLM_ENABLED=
# LLM_TENANT_ALLOWLIST=
# LLM_TENANT_DENYLIST=
# LLM_FEATURES=generate
# Production: an endpoint that is not loopback/private/listed here is external and needs LLM_EXTERNAL_ALLOWED=true.
# LLM_INTERNAL_HOSTS=localhost
# LLM_EXTERNAL_ALLOWED=false
# LLM_FEATURE_MAX_TOKENS=512
# true: drop sentences of an LLM-generated answer that the cited evidence does not support (rag_core/grounding.py).
GROUNDING_VERIFY_ENABLED=false
# Share of a sentence's content terms the cited evidence must hold.
GROUNDING_MIN_COVERAGE=0.5
# ruri-v3 models get "検索クエリ: " / "検索文書: " automatically. Override only
# for other models; quote values that end with a space. An empty value
# disables the model default.
# EMBED_QUERY_PREFIX="query: "
# EMBED_DOCUMENT_PREFIX="passage: "

# --- Corpus / retrieval ---
CHUNKS_JSONL_PATH=index/chunks.canonical.bytype.dedup.jsonl
# VECTORSTORE_DIR=vectorstore/
# CHROMA_COLLECTION is an optional runtime override for the Chroma collection.
# CHROMA_COLLECTION=chatbot_chunks_v1_aligned_candidate
# VECTORSTORE_COLLECTION_NAME=chatbot_chunks_v1_aligned_candidate
# Keyword tokenizer: auto | sudachi | heuristic (Sudachi: requirements-ja.txt)
KEYWORD_TOKENIZER=auto
# SUDACHI_DICT=core
# SUDACHI_SPLIT_MODE=A
# KEYWORD_NGRAM_ENABLED=true
# Hybrid fusion: weighted_rrf | dbsf. Tune weights and k on the evaluation set.
HYBRID_FUSION=weighted_rrf
# HYBRID_RRF_K=60
# HYBRID_DENSE_WEIGHT=1.0
# HYBRID_KEYWORD_WEIGHT=1.0
# HYBRID_EXACT_WEIGHT=1.0
# Push the default tenant into the vector DB filter. Run
# scripts/backfill_tenant_id.py --apply first.
TENANT_FILTER_STRICT=false

# --- Cross-encoder rerank (opt-in) ---
CROSS_ENCODER_RERANK_ENABLED=false
# CROSS_ENCODER_MODEL=cl-nagoya/ruri-v3-reranker-310m
# CROSS_ENCODER_TOP_N=30
# CROSS_ENCODER_MAX_LENGTH=512

# --- Approved Q&A (deterministic exact-match answers) ---
APPROVED_QA_ENABLED=false
APPROVED_QA_PATH=data/approved_qa/default.jsonl

# --- API exposure hardening ---
API_AUTH_ENABLED=false
# Comma-separated accepted keys; required (non-empty) when API_AUTH_ENABLED=true.
API_AUTH_KEYS=
# Optional API key -> tenant authorization map (key1=tenant_a,key2=tenant_a|tenant_b).
# When set (and API_AUTH_ENABLED=true), each key may access only its listed
# tenant_id values; valid keys missing from the map are rejected with 403.
# When unset, legacy behavior is preserved: any valid key may access any tenant_id.
# Never commit real keys; rotate any key that leaks.
API_AUTH_TENANT_MAP=REPLACE_API_KEY_1=default
ADMIN_AUTH_ENABLED=false
ADMIN_AUTH_TOKEN=
# --- Enterprise auth bridge (default off; trusted reverse-proxy headers) ---
# Safe integration boundary only — the IdP (SAML/OIDC/LDAP/AD) lives in front
# of the app in a reverse proxy/gateway. When true, enterprise identity headers
# (X-Enterprise-Tenant / -User / -Email / -Groups) are honored ONLY if the
# request also carries X-Enterprise-Auth-Trust matching ENTERPRISE_AUTH_TRUST_TOKEN.
# Identity maps to allowed tenants via ENTERPRISE_AUTH_TENANT_MAP; it never
# broadens the request tenant_id and never replaces the API key path.
ENTERPRISE_AUTH_ENABLED=false
# Shared secret the trusted proxy sends in X-Enterprise-Auth-Trust. Never commit.
ENTERPRISE_AUTH_TRUST_TOKEN=
# enterprise-identity -> allowed tenant(s): entTenantA=tenant_a,grpX=tenant_b|tenant_c
ENTERPRISE_AUTH_TENANT_MAP=
# /search/debug exposes retrieval internals; disable or protect in production.
SEARCH_DEBUG_ENABLED=true
# Comma-separated origin allowlist; empty = no CORS middleware.
CORS_ALLOW_ORIGINS=
# In-process rate limiting on the API-key-protected POST endpoints
# (/chat, /chat/stream, /chat/product-preview, /chat/feedback, /search).
# Default off; behavior is unchanged unless enabled. The budget is keyed by
# API key fingerprint (anonymous requests share one bucket) and is enforced
# PER PROCESS: with multiple uvicorn workers each worker has its own budget.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Per-tenant product profile on /chat (opt-in) ---
# When true, /chat and /chat/stream resolve the per-tenant product profile at
# runtime (via API_AUTH_TENANT_MAP-authorized tenant context) and apply its
# candidate limit; unknown/invalid/disabled tenants fall back to the safest
# profile (production_safe). Default false leaves /chat behavior unchanged.
# This does NOT replace API auth, tenant authorization, or tenant isolation.
CHAT_USE_TENANT_PROFILE=false

# --- Answer cache (opt-in, /chat only) ---
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_MAX_ENTRIES=256

# --- Audit logging ---
AUDIT_CHAT_ENABLED=true
AUDIT_SEARCH_DEBUG_ENABLED=true

# =====================================================================
# Settings added in P1 and v3 stages 1-8. Defaults keep the historical
# behaviour unless noted. See each stage's README for details.
# =====================================================================

# --- Deployment mode (stage 6) ---
# production: refuses to start with unsafe settings, minimal /health,
# token-protected /metrics, no /docs. The Docker image sets production.
APP_ENV=development
ALLOWED_HOSTS=
METRICS_TOKEN=
FORWARDED_ALLOW_IPS=127.0.0.1
API_DOCS_ENABLED=
SECURITY_CSP=
MAX_REQUEST_BYTES=1048576
MAX_QUESTION_CHARS=4000
MAX_TOP_K=100
MAX_CONTEXT_CHARS_LIMIT=32000

# --- Authorization (stage 1) ---
ADMIN_AUTH_ALLOW_INSECURE_DEV=false
API_AUTH_ALLOW_ANY_TENANT_WITHOUT_MAP=false
OIDC_ALLOW_ANY_TENANT_WITHOUT_MAP=false
RAG_PROFILE_TENANT_MAP=

# --- OIDC (stage 6 / 8) ---
OIDC_DISCOVERY=false
OIDC_JWKS_TTL_SECONDS=3600
OIDC_JWKS_MIN_REFRESH_SECONDS=60
# 32+ bytes in production
OIDC_SESSION_SECRET=

# --- Ingestion (stages 1, 3, 8) ---
INGEST_ALLOWED_ROOTS=
INGEST_MAX_FILES=100
INGEST_MAX_FILE_BYTES=52428800
INGESTION_REGISTRY_PATH=
INGEST_EMBED_PARENT_CHUNKS=true
INGEST_WORKERS=1
XLSX_INCLUDE_HIDDEN=false
PPTX_INCLUDE_HIDDEN_SLIDES=false

# --- Approved QA (stages 1, 5) ---
APPROVED_QA_EXACT_INDEX_PATH=
APPROVED_QA_EXACT_NEAR_MATCH=false
APPROVED_QA_EXACT_ALLOW_EVAL_ARTIFACTS=false
APPROVED_QA_STRICT=false

# --- Retrieval (P1, stages 3, 5, 8) ---
KEYWORD_INDEX_ENGINE=inverted
# Guard distance thresholds (cosine distance of the best vector hit) depend on the
# embedding model: calibrate after choosing the model (scripts/calibrate_distance_guard.py)
# and set RAG_DIST_CALIBRATED_MODEL to it. Defaults were tuned with
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2.
RAG_DIST_CALIBRATED_MODEL=
RAG_SOFT_DIST_OTHER=0.65
RAG_HARD_MAX_DIST=0.95
# Stage 14: background (default in production) keeps serving the previous keyword
# index while a changed corpus is rebuilt; sync rebuilds inside the request.
KEYWORD_INDEX_REFRESH=
BM25_K1=1.5
BM25_B=0.75
KEYWORD_NUMERIC_TOKENS=false
HYBRID_PARALLEL=false
CROSS_ENCODER_SKIP_MARGIN=0
NORMALIZATION_PROFILE=legacy
READING_LANE_ENABLED=false
READING_LANE_MIN_BM25=2.0
# 0 disables; otherwise skip the second (augmented) retrieval when the first
# pass's top-1 fused score leads by at least this much (fit with eval.bench).
STAGED_RETRIEVAL_MARGIN=0
RERANK_HEURISTIC_ENABLED=true
RERANK_EXCLUDED_TERMS=

# --- Vector store (stage 7) ---
VECTOR_BACKEND=chroma
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_PATH=
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=128
QDRANT_SEARCH_EF=128
QDRANT_QUANTIZATION=

# --- Answer pipeline switches (stage 5; "legacy" restores the old rule) ---
INTENT_RULES=cue_required
COMPOSE_QUERY_MODE=definition_only
PREFER_SORT_MODE=tiebreak
EXTRACTIVE_EVIDENCE_RULE=coverage
EXTRACTIVE_TERM_MODE=regex
QUERY_PREPROCESS_ENABLED=false
QUERY_SYNONYM_EXPANSION=true
QUERY_TYPO_CORRECTION=true

# --- Conversation (stage 8) ---
CONVERSATION_HISTORY_ENABLED=false
CONVERSATION_CONTEXT_ENABLED=false

# --- Audit (stage 6) ---
# plain | mask | hash | drop. Empty: mask in production, plain otherwise (stage 14).
AUDIT_QUESTION_MODE=
AUDIT_MAX_BYTES=52428800

# --- Rate limit (stage 6) ---
RATE_LIMIT_ANONYMOUS_BY_IP=false

# --- Shared state for several nodes (stage 8; local = single node) ---
REDIS_URL=
POSTGRES_URL=
RATE_LIMIT_BACKEND=local
ANSWER_CACHE_BACKEND=local
ANSWER_CACHE_TTL_SECONDS=3600
SESSION_REVOCATION_BACKEND=local
# redis: the circuit breakers of the LLM endpoints are shared between workers and nodes (webapi/breaker_store.py)
BREAKER_BACKEND=local
CONVERSATION_STORE_BACKEND=local
INGESTION_REGISTRY_BACKEND=local

# --- Admin browser login (stage 9): /admin/login sets a signed cookie ---
# Plain-HTTP testing needs OIDC_COOKIE_SECURE=false (the cookie is Secure).
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_ATTEMPTS_PER_MINUTE=10

# --- Document extraction (stage 9) ---
PDF_TABLES=true
PDF_OCR_IMAGE_MIN_AREA=0.1
OFFICE_OCR_IMAGES=false
OCR_LANG=jpn

# --- Keyword index persistence (stage 9; recommended true in production) ---
KEYWORD_INDEX_PERSIST=false
# Signing key of the cache files (empty: a random key file next to the cache)
KEYWORD_INDEX_CACHE_KEY=

# --- Document extraction backends (stage 10, libs/docextract) ---
# python -m docextract check  shows what is installed and license notes.
# Tables: auto = first installed of DOCEXTRACT_TABLE_PREFERENCE.
DOCEXTRACT_TABLE_BACKEND=auto
DOCEXTRACT_TABLE_PREFERENCE=docling,pdfplumber
DOCEXTRACT_BORDERLESS_TABLES=true
DOCEXTRACT_TABLE_MIN_CONFIDENCE=0.65
DOCEXTRACT_MERGE_CONTINUED_TABLES=true
DOCEXTRACT_DOCLING_MODE=accurate
DOCEXTRACT_DOCLING_OCR=none
# OCR engines in order (paddle = PaddleOCR PP-OCRv6, tesseract = Tesseract 5)
DOCEXTRACT_OCR_ENGINES=paddle,tesseract
DOCEXTRACT_TESSERACT_LANG=
DOCEXTRACT_PADDLE_LANG=japan
# PP-OCRv6 (paddleocr >= 3.7; older paddleocr falls back to PP-OCRv5)
DOCEXTRACT_PADDLE_OCR_VERSION=PP-OCRv6
# medium (accurate) or small (about 3x faster on CPU, a little less accurate)
DOCEXTRACT_PADDLE_TIER=medium
# Offline sites: local model folders
DOCEXTRACT_PADDLE_DET_MODEL_DIR=
DOCEXTRACT_PADDLE_REC_MODEL_DIR=
# auto: turn oneDNN off after the known paddlepaddle 3.3 CPU error
DOCEXTRACT_PADDLE_MKLDNN=auto
DOCEXTRACT_PADDLE_ENGINE=
# Below this confidence the next OCR engine is tried as well (best result kept)
DOCEXTRACT_OCR_ACCEPT_CONFIDENCE=60
# YomiToku needs a commercial license for business use; true only if you hold one
DOCEXTRACT_YOMITOKU_LICENSED=false
DOCEXTRACT_DEVICE=cpu
PDF_OCR_MIN_CONFIDENCE=60
OFFICE_OCR_MIN_CONFIDENCE=50

# --- Shared services: connections (stage 10) ---
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_RETRIES=2
REDIS_CA_CERT=
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10
POSTGRES_STATEMENT_TIMEOUT_MS=5000
# true: a session whose revocation cannot be checked (Redis down) is refused
SESSION_REVOCATION_FAIL_CLOSED=true
QDRANT_PREFER_GRPC=false
QDRANT_CA_CERT=
QDRANT_RETRIES=2
QDRANT_UPSERT_BATCH=256
QDRANT_META_COLLECTION=_kuraden_meta

# --- OIDC (stage 10) ---
OIDC_ID_TOKEN_ALGS=RS256,PS256,ES256
OIDC_CLOCK_SKEW_SECONDS=60
OIDC_CA_BUNDLE=
OIDC_TOKEN_AUTH_METHOD=client_secret_post
OIDC_SESSION_TTL_SECONDS=3600
OIDC_END_SESSION_ENDPOINT=
OIDC_POST_LOGOUT_REDIRECT_URI=

# --- Admin uploads and metrics (stage 10) ---
INGEST_UPLOAD_DIR=
INGEST_UPLOAD_MAX_BYTES=52428800
# Uploaded files older than this are removed (0 = keep)
INGEST_UPLOAD_RETENTION_DAYS=30
# Processes converting the files of one ingestion job in parallel (1 = sequential)
INGEST_CONVERT_WORKERS=1
# Several uvicorn workers on one node: counters are summed through this directory
METRICS_MULTIPROC_DIR=

# --- Deployment-specific endpoints and timeouts (S1). Defaults equal the former fixed values. ---
# Microsoft Graph (SharePoint source, Outlook drafts): set these for a sovereign cloud or a proxy.
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_TOKEN_URL=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token
GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_HTTP_TIMEOUT_SECONDS=60
GRAPH_MAX_WAIT_SECONDS=60
# Alert notifications
NOTIFY_SLACK_TIMEOUT_SECONDS=10
NOTIFY_SMTP_TIMEOUT_SECONDS=15
# OIDC token and JWKS calls
OIDC_HTTP_TIMEOUT_SECONDS=15
OIDC_RETRY_WAIT_SECONDS=0.5
# Remote embeddings endpoint, when it differs from OPENAI_BASE_URL (empty: use OPENAI_BASE_URL)
EMBEDDING_BASE_URL=

# --- External integrations (S1): the environment layer of the switches. Empty = no external integration may be used. ---
# Names: sharepoint, outlook_draft, smtp, slack. A switch in the console (reason required) and a tenant switch narrow it.
EXTERNAL_INTEGRATIONS=
# Where the console's runtime switches are kept (empty: runs/settings)
RUNTIME_SETTINGS_DIR=

# --- LLM gateway (S2) ---
# Model profiles (JSON file of the deployment; see config/deploy/llm_profiles.example.json). Empty: OPENAI_BASE_URL / CHAT_MODEL only.
LLM_PROFILES_FILE=
# Circuit breaker per profile: open after N failures in a row, for S seconds, then trial calls
LLM_BREAKER_ENABLED=true
LLM_BREAKER_FAILURE_THRESHOLD=3
LLM_BREAKER_OPEN_SECONDS=60
LLM_BREAKER_PROBES=1
# Usage log (no question or answer text): one line per call, a file per day. Empty directory: runs/usage
LLM_USAGE_ENABLED=true
LLM_USAGE_DIR=

# --- Records of questions and answers (S3) ---
# off | anonymous | standard | detailed. DEFAULT applies until the console sets a level; MAX is the ceiling the console may set.
RECORD_LEVEL_DEFAULT=off
RECORD_LEVEL_MAX=standard
RECORDS_DIR=
RECORDS_RETENTION_DAYS=365
RECORDS_DETAILED_RETENTION_DAYS=30
# anonymize | delete (run by POST /admin/records/purge or scripts/records_purge.py; nothing is purged by itself)
RECORDS_EXPIRY_ACTION=anonymize
# Secret salt for the pseudonyms of the anonymous level (empty: made once and kept beside the runtime settings)
RECORDS_HASH_SALT=
LLM_USAGE_RETENTION_DAYS=400

# --- Golden questions and business hours (S4) ---
GOLDEN_QA_DIR=
# Availability is counted in business hours, weekdays only: offset from UTC (hours) and first/last hour
BUSINESS_HOURS_UTC_OFFSET=9
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=21

# --- LLM limits and batches (S6). 0 = no limit. The console sets limits per tenant too (with a reason). ---
LLM_QUOTA_USER_DAILY_CALLS=0
LLM_QUOTA_USER_DAILY_TOKENS=0
LLM_QUOTA_TENANT_DAILY_TOKENS=0
LLM_QUOTA_TENANT_DAILY_COST=0
LLM_QUOTA_GLOBAL_DAILY_COST=0
LLM_QUOTA_WARN_RATIO=0.8
# Features a limit does not apply to (comma separated)
LLM_QUOTA_EXEMPT_FEATURES=judge
LLM_QUOTA_CACHE_SECONDS=10
# Price factor of a call made through a provider's batch API (check the provider's price)
LLM_BATCH_COST_FACTOR=0.5

# --- Two-person approval (S7): turning an external integration on needs a second, different person. 1 = no second person. ---
INTEGRATION_APPROVALS_REQUIRED=2
APPROVAL_EXPIRY_HOURS=72
# true: only people identified by single sign-on may approve (a name typed in the console proves nothing)
APPROVAL_REQUIRE_SSO=false

# --- Availability from an external probe (S7) ---
# The log written by scripts/external_probe.py (a path the service can read: a shared volume, or a copy). Empty: not shown.
PROBE_LOG_FILE=
AVAILABILITY_TARGET_PERCENT=99.0
PROBE_MAX_GAP_SECONDS=300
