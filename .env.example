# Copy to .env and fill in real values. Never commit .env.
# All values below are placeholders or the code defaults from config.py.

# --- OpenAI / LLM provider ---
OPENAI_API_KEY=sk-REPLACE_ME
# OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini

# --- Chat completion hardening ---
CHAT_COMPLETION_TIMEOUT_SECONDS=30
CHAT_COMPLETION_MAX_RETRIES=1
CHAT_COMPLETION_RETRY_BACKOFF_SECONDS=1.0
CHAT_COMPLETION_MAX_TOKENS=1024

# --- Embeddings ---
# Providers: local | openai | bge_m3
# Must match the provider/model the vectorstore was ingested with
# (the collection is fingerprint-stamped at ingest and verified at query time).
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Corpus / retrieval ---
CHUNKS_JSONL_PATH=index/chunks.canonical.bytype.dedup.jsonl
# VECTORSTORE_DIR=vectorstore/
# VECTORSTORE_COLLECTION_NAME=chatbot_chunks_v1

# --- Approved Q&A (deterministic exact-match answers) ---
APPROVED_QA_ENABLED=false
APPROVED_QA_PATH=data/approved_qa/default.jsonl

# --- API exposure hardening ---
API_AUTH_ENABLED=false
# Comma-separated accepted keys; required (non-empty) when API_AUTH_ENABLED=true.
API_AUTH_KEYS=
# Optional API key -> tenant authorization map (key1=tenant_a,key2=tenant_a|tenant_b).
# When set (and API_AUTH_ENABLED=true), each key may access only its listed
# tenant_id values; valid keys missing from the map are rejected with 403.
# When unset, legacy behavior is preserved: any valid key may access any tenant_id.
# Never commit real keys; rotate any key that leaks.
API_AUTH_TENANT_MAP=REPLACE_API_KEY_1=default
ADMIN_AUTH_ENABLED=false
ADMIN_AUTH_TOKEN=
# /search/debug exposes retrieval internals; disable or protect in production.
SEARCH_DEBUG_ENABLED=true
# Comma-separated origin allowlist; empty = no CORS middleware.
CORS_ALLOW_ORIGINS=
# In-process rate limiting on the API-key-protected POST endpoints
# (/chat, /chat/stream, /chat/product-preview, /chat/feedback, /search).
# Default off; behavior is unchanged unless enabled. The budget is keyed by
# API key fingerprint (anonymous requests share one bucket) and is enforced
# PER PROCESS: with multiple uvicorn workers each worker has its own budget.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Per-tenant product profile on /chat (opt-in) ---
# When true, /chat and /chat/stream resolve the per-tenant product profile at
# runtime (via API_AUTH_TENANT_MAP-authorized tenant context) and apply its
# candidate limit; unknown/invalid/disabled tenants fall back to the safest
# profile (production_safe). Default false leaves /chat behavior unchanged.
# This does NOT replace API auth, tenant authorization, or tenant isolation.
CHAT_USE_TENANT_PROFILE=false

# --- Answer cache (opt-in, /chat only) ---
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_MAX_ENTRIES=256

# --- Audit logging ---
AUDIT_CHAT_ENABLED=true
AUDIT_SEARCH_DEBUG_ENABLED=true
