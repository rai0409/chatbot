{
  "profile_name": "dev_debug",
  "operation_mode": "dev_debug",
  "runtime_serving": false,
  "features": {
    "audit": true,
    "feedback": true,
    "review_queue": true,
    "metrics": true,
    "feature_rerank": true,
    "feedback_preview_rerank": true,
    "combined_rerank": true,
    "debug_comparison": true,
    "llm_answer": false,
    "llm_rerank": false
  },
  "answer_policy": {
    "allow_exact_answer": true,
    "allow_similar_auto_answer": false,
    "force_candidate_only_for_similar": true,
    "fallback_to_no_answer": true,
    "human_review_on_low_confidence": true
  },
  "limits": {
    "max_candidates_internal": 20,
    "max_candidates_display": 10,
    "max_latency_ms_target": 5000
  },
  "cost_policy": {
    "budget_tier": "debug",
    "allow_llm_calls": false,
    "allow_batch_eval_only": true
  },
  "override_policy": {
    "allow_request_overrides": true,
    "safe_narrowing_only": true
  }
}
